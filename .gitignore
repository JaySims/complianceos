# ============================================================
# ComplianceOS Monorepo
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/
out/
**/out/

# Build output
build/
dist/
coverage/

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*

# Allow environment templates
!.env.example
!**/.env.example

# Vercel
.vercel/
**/.vercel/

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS
.DS_Store
**/.DS_Store

# Certificates / keys
*.pem
*.key
*.p12
*.pfx

# Editor
.vscode/
.idea/

# Temporary / backup files
*.save
*.bak
*.tmp
*~
*.swp

# Prisma generated client
**/app/generated/prisma/

# Local database files
*.db
*.db-journal
