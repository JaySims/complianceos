generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(cuid())
  fullName        String
  email           String           @unique
  password        String?
  role            UserRole         @default(USER)
  organizationId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assessments     Assessment[]
  recommendations Recommendation[]
  organization    Organization?    @relation("PrimaryOrganizationUsers", fields: [organizationId], references: [id])

  memberships OrganizationMember[]

  executiveMissions ExecutiveMission[] @relation("MissionStartedBy")
}

model Organization {
  id                  String       @id @default(cuid())
  name                String
  tradingName         String?
  registrationNumber  String?      @unique
  website             String?
  industry            String?
  country             String?
  employeeCount       Int?
  trustScore          Float        @default(0)
  complianceScore     Float        @default(0)
  onboardingCompleted Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  assessments         Assessment[]
  documents           Document[]
  users               User[]       @relation("PrimaryOrganizationUsers")

  members OrganizationMember[]

  workflowProgress WorkflowProgress[]

  executiveMissions ExecutiveMission[]
}

model Framework {
  id          String       @id @default(cuid())
  name        String
  version     String?
  description String?
  createdAt   DateTime     @default(now())
  assessments Assessment[]
}

model Assessment {
  id             String           @id @default(cuid())
  title          String
  score          Float?
  status         AssessmentStatus @default(DRAFT)
  organizationId String
  frameworkId    String
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  framework      Framework        @relation(fields: [frameworkId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  evidence       Evidence[]
}

model Evidence {
  id           String     @id @default(cuid())
  title        String
  fileUrl      String
  assessmentId String
  createdAt    DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
}

model Recommendation {
  id          String   @id @default(cuid())
  title       String
  description String
  priority    Int      @default(1)
  completed   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Document {
  id             String       @id @default(cuid())
  documentType   String
  fileName       String
  filePath       String
  fileSize       Int?
  mimeType       String?
  verified       Boolean      @default(false)
  uploadedAt     DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userEmail String?
  timestamp DateTime @default(now())
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationMemberRole @default(MEMBER)
  active         Boolean                @default(true)
  joinedAt       DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model WorkflowProgress {
  id               String    @id @default(cuid())
  organizationId   String
  workflowId       String
  completedStepIds String[]  @default([])
  progress         Int       @default(0)
  completed        Boolean   @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workflowId])
  @@index([organizationId])
  @@index([workflowId])
}

model ExecutiveMission {
  id              String                 @id @default(cuid())
  organizationId  String
  workflowId      String
  actionId        String
  title           String
  route           String
  status          ExecutiveMissionStatus @default(ACTIVE)
  progress        Int                    @default(0)
  startedByUserId String?
  startedAt       DateTime               @default(now())
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedByUser User?        @relation("MissionStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
  @@index([startedByUserId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AUDITOR
  USER
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MANAGER
  AUDITOR
  MEMBER
}

enum ExecutiveMissionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}
